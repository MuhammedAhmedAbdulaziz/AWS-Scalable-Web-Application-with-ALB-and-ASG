{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnDatabaseSecretOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-1:111122223333:secret:rds!db-*"
    },
    {
      "Sid": "ReadStaticAssetsPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::saa-p1-static/*"
    },
    {
      "Sid": "ReadApplicationParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:eu-west-1:111122223333:parameter/saa-p1/*"
    },
    {
      "Sid": "DenyAnythingNotOverTls",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
